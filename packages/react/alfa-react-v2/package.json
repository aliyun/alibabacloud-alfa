{
  "name": "@alicloud/alfa-react",
  "version": "2.0.0-alpha.1",
  "description": "Alfa Framework (React Version)",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "types/index.d.ts",
  "author": "pushiming",
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "npm run version && npm run babel && npm run babel:esm && npm run types",
    "pub": "pnpm publish",
    "build": "breezr build --engine webpack",
    "babel": "breezr build --engine babel",
    "babel:esm": "breezr build --engine babel --es-module",
    "types": "tsc --emitDeclarationOnly -d --declarationDir ./types",
    "storybook": "breezr start-storybook",
    "clean": "rm -rf lib es dist types yarn.lock",
    "start": "storybook dev -p 6006",
    "precommit": "npm run version",
    "version": "node -p \"'export const version = \\'' + require('./package.json').version + '\\';'\" > src/version.ts && git add src/version.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@alicloud/console-toolkit-cli": "^1.0.1",
    "@alicloud/console-toolkit-preset-wind-component": "^1.0.0",
    "@chromatic-com/storybook": "^3.2.6",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@types/axios": "^0.14.0",
    "@types/chai": "^4.1.7",
    "@types/classnames": "^2.2.9",
    "@types/crypto-js": "^4.0.2",
    "@types/jest": "^23.3.13",
    "@types/lodash": "^4.14.176",
    "@types/lodash-es": "^4.17.12",
    "@types/prop-types": "^15.7.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/react-lazyload": "^3.2.3",
    "@types/single-spa-react": "^2.8.3",
    "jest": "^23.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.86.3",
    "storybook": "^8.6.12",
    "ts-jest": "^23.10.5",
    "tslib": "^2.4.0",
    "typescript": "^4.0.0",
    "vite": "^6.3.2",
    "vite-plugin-node-polyfills": "^0.23.0"
  },
  "dependencies": {
    "@alicloud/alfa-core": "workspace:^",
    "@alicloud/console-base-messenger": "^1.18.1",
    "@alicloud/console-os-loader": "workspace:^",
    "@alicloud/widget-utils-console": "^0.1.6",
    "@alicloud/xconsole-context": "^2.4.32",
    "axios": "^0.21.4",
    "classnames": "^2.2.6",
    "crypto-js": "^4.1.1",
    "lodash-es": "^4.17.21",
    "prop-types": "^15.8.1",
    "react-lazyload": "^3.2.1"
  },
  "peerDependencies": {
    "react": ">=16.0.0",
    "react-dom": ">=16.0.0"
  }
}
